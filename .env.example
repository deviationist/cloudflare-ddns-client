# Copy to .env and fill in. Only needed when the WAN failover / CGNAT guard is
# enabled (a `router` block in config.json) — without that block the client
# reads nothing from here.
#
# The router credentials for the password-based transports (asuswrt-merlin
# `web`, routeros `rest`) are kept out of config.json: `usernameEnv` and
# `passwordEnv` name the variables to read them from, so the config file stays
# safe to share. The ssh transports use key auth and read neither; their user
# is `ssh.user` in config.json.
#
# Load it by running node with --env-file, which needs no dependency:
#   node --env-file-if-exists=./.env ./src/index.js
#
# Keep this file mode 0600. It is gitignored.

ROUTER_USERNAME=
ROUTER_PASSWORD=
