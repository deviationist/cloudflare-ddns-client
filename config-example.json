{
  "serviceId": "your-ddns-service",
  "logFile": "/var/log/cloudflare-ddns/app.log",
  "ipHistoryFile": "/var/log/cloudflare-ddns/ip-history.log",
  "notificationMailAddress": "to-address@example.com",
  "mailConfig": {
    "fromAddress": "ddns@yourdomain.com",
    "smtp": {
      "host": "smtp-relay.brevo.com",
      "port": 587,
      "secure": false,
      "login": "your-brevo-account@example.com",
      "password": "your-brevo-smtp-api-key"
    }
  },
  "router": {
    "driver": "asuswrt-merlin",
    "stateFile": "/var/log/cloudflare-ddns/router-guard.json",
    "options": {
      "url": "https://192.168.1.1:8443",
      "username": "admin",
      "passwordEnv": "ROUTER_PASSWORD",
      "verifySsl": false
    }
  },
  "items": [
    {
      "apiKey": "your-api-key",
      "zones": [
        {
          "zoneId": "your-zone-id",
          "dnsRecords": [
            "domain.com",
            "domain.eu"
          ]
        },
        {
          "zoneId": "your-zone-id2",
          "dnsRecords": [
            "foo.com",
            "bar.com"
          ]
        }
      ]
    },
    {
      "zones": [
        {
          "apiKey": "your-api-key-for-zone",
          "zoneId": "your-zone-id",
          "dnsRecords": [
            "domain.com",
            "domain.eu"
          ]
        },
        {
          "apiKey": "your-api-key-for-zone",
          "zoneId": "your-zone-id2",
          "dnsRecords": [
            "foo.com",
            "bar.com"
          ]
        }
      ]
    }
  ]
}