{
  "serviceId": "your-ddns-service",
  "logFile": "/var/log/cloudflare-ddns/app.log",
  "ipHistoryFile": "/var/log/cloudflare-ddns/ip-history.log",
  "ipStateFile": "/var/lib/cloudflare-ddns/last-ip",
  "notificationMailAddress": "to-address@example.com",
  "mailConfig": {
    "fromAddress": "ddns@yourdomain.com",
    "smtp": {
      "host": "smtp-relay.brevo.com",
      "port": 587,
      "secure": false,
      "login": "your-brevo-account@example.com",
      "password": "your-brevo-smtp-api-key"
    }
  },
  "hooks": [
    "/path/to/simple-script.sh",
    {
      "name": "brevo-ip-allowlist",
      "on": ["publicIpChanged", "dnsRecordUpdated"],
      "once": true,
      "stopOnError": false,
      "command": "/path/to/authorize-ip.sh",
      "args": ["--provider", "brevo"],
      "cwd": "/path/to",
      "env": {
        "BREVO_API_KEY": "your-brevo-api-key"
      },
      "timeout": 60000,
      "shell": false,
      "enabled": true
    },
    {
      "name": "alert-on-failure",
      "on": ["error"],
      "command": "/path/to/alert.sh"
    }
  ],
  "items": [
    {
      "apiKey": "your-api-key",
      "zones": [
        {
          "zoneId": "your-zone-id",
          "dnsRecords": [
            "domain.com",
            "domain.eu"
          ]
        },
        {
          "zoneId": "your-zone-id2",
          "dnsRecords": [
            "foo.com",
            "bar.com"
          ]
        }
      ]
    },
    {
      "zones": [
        {
          "apiKey": "your-api-key-for-zone",
          "zoneId": "your-zone-id",
          "dnsRecords": [
            "domain.com",
            "domain.eu"
          ]
        },
        {
          "apiKey": "your-api-key-for-zone",
          "zoneId": "your-zone-id2",
          "dnsRecords": [
            "foo.com",
            "bar.com"
          ]
        }
      ]
    }
  ]
}