{
  "serviceId": "your-ddns-service",
  "errorRecipientMailAddress": "to-address@example.com",
  "mailConfig": {
    "fromAddress": "ddns@yourdomain.com",
    "smtp": {
      "host": "smtp-relay.brevo.com",
      "port": 587,
      "secure": false,
      "login": "your-brevo-account@example.com",
      "password": "your-brevo-smtp-api-key"
    }
  },
  "items": [
    {
      "apiKey": "your-api-key",
      "zones": [
        {
          "zoneId": "your-zone-id",
          "dnsRecords": [
            "domain.com",
            "domain.eu"
          ]
        },
        {
          "zoneId": "your-zone-id2",
          "dnsRecords": [
            "foo.com",
            "bar.com"
          ]
        }
      ]
    },
    {
      "zones": [
        {
          "apiKey": "your-api-key-for-zone",
          "zoneId": "your-zone-id",
          "dnsRecords": [
            "domain.com",
            "domain.eu"
          ]
        },
        {
          "apiKey": "your-api-key-for-zone",
          "zoneId": "your-zone-id2",
          "dnsRecords": [
            "foo.com",
            "bar.com"
          ]
        }
      ]
    }
  ]
}